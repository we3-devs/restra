# Site
NEXT_PUBLIC_SITE_URL=https://restra-services.vercel.app

# Freebuff error monitoring (optional)
NEXT_PUBLIC_VLY_APP_ID=
NEXT_PUBLIC_VLY_MONITORING_URL=

# Supabase (optional — enables blog posts + media from Supabase at build time)
# Blog posts are served from the static TypeScript seeds when these are empty.
# See docs/blog-supabase.md for the expected table schema and storage layout.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
